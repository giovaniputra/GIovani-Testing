# Salin ke pengaturan Environment di layanan hosting. JANGAN commit nilai asli.
APP_ENV=production
WHATSAPP_VERIFY_TOKEN=isi-teks-acak-buatan-sendiri
WHATSAPP_APP_SECRET=App Secret dari Meta (App settings > Basic)
WHATSAPP_TOKEN=Access token dari Meta (API Setup)
WHATSAPP_PHONE_NUMBER_ID=Phone number ID dari Meta (API Setup)
DEMO_PHONE=628xxxxxxxxxx        # nomor WA Anda (format 62..., tanpa +)
# ANTHROPIC_API_KEY=            # opsional, pembacaan order oleh LLM
