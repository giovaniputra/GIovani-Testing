# Amazon SP-API app credentials (Seller Central > Apps & Services > Develop apps)
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=

# IAM role SP-API assumes to call AWS-signed endpoints
SP_API_ROLE_ARN=
SP_API_ACCESS_KEY_ID=
SP_API_SECRET_ACCESS_KEY=

# Marketplace to query (e.g. ATVPDKIKX0DER = US, A21TJRUUN4KGV = IN)
SP_API_MARKETPLACE_ID=
SP_API_REGION=na

# SQL Server connection (SQL login auth)
SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_ENCRYPT=true
SQL_SERVER_TRUST_SERVER_CERT=false
